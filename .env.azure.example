# Azure App Service backend settings
APP_ENV=production
SERVICE_NAME=battery-dispatch-optimizer-api
API_PUBLIC_BASE_URL=https://your-backend-app.azurewebsites.net
FRONTEND_ORIGIN=https://your-frontend-app.azurewebsites.net

# Local development can use dev auth. Production should use entra once auth is implemented.
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# Keep local file storage during early pilots. Switch to azure_blob after storage abstraction is implemented.
STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER_NAME=battery-dispatch-data

# Use Azure PostgreSQL later. Keep empty until database repositories are implemented.
DATABASE_URL=

# Store real secrets in Azure App Settings or Key Vault references, not in source code.
KEY_VAULT_URL=
ENTSOE_API_KEY=
ENTSOE_VERIFY_SSL=true
APPLICATIONINSIGHTS_CONNECTION_STRING=
